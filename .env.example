# Copy to .env.local and fill in real values. All variables are optional
# for local development — if any are missing, the inquiry flow falls back
# to log-only mode and the app still runs.

# ---------------------------------------------------------------------------
# Supabase — database + auth (Phase 4) + storage (Phase 2)
# ---------------------------------------------------------------------------
# Grab from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only — NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — transactional email for inquiry notifications
# ---------------------------------------------------------------------------
# API key from resend.com → API Keys.
RESEND_API_KEY=

# Comma-separated list of recipients for new-inquiry emails.
# Defaults to sale2@i-coming.com if unset.
INQUIRY_TO_EMAIL=sale2@i-coming.com

# From-address for inquiry emails. V1 uses Resend's sandbox sender;
# verify a real domain (e.g. rfq@i-coming.com) for production.
# RESEND_FROM_EMAIL=ICOMing RFQ <onboarding@resend.dev>
